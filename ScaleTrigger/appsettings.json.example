{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "// FileEnabled": "true (default) = also write logs/scaletrigger-*.json next to the app, on top of the console sink Program.cs always configures; false = console only. Set to false on App Service (see app-service.bicep) - its filesystem is a network share, and per-vote logging under load turns that into avoidable I/O.",
    "FileEnabled": true
  },

  "DatabaseProvider": "Sqlite",

  "// UseManagedIdentity": "false = connection string password; true = Azure AD Managed Identity",
  "UseManagedIdentity": false,

  "Auth": {
    "// Enabled": "true = POST /api/vote/add requires a JWT from POST /api/auth/login",
    "Enabled": false
  },

  "Startup": {
    "// FailFastOnDbCheck": "true = stop immediately if the database is unreachable at startup; false = log and keep running",
    "FailFastOnDbCheck": false
  },

  "// ConnectionStrings": "Max Pool Size raised well above the ADO.NET default (100) so the pool isn't the bottleneck under high-concurrency load testing. No such setting for Sqlite.",
  "ConnectionStrings": {
    "MsSql": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=ScaleTriggerDb;User ID=YOUR-USER;Password=YOUR-PASSWORD;Encrypt=True;TrustServerCertificate=True;Max Pool Size=1000;",
    "MySql": "Server=YOUR-SERVER.mysql.database.azure.com;Port=3306;Database=ScaleTriggerDb;Uid=YOUR-USER;Pwd=YOUR-PASSWORD;SslMode=Required;Max Pool Size=1000;",
    "PostgreSql": "Server=YOUR-SERVER.postgres.database.azure.com;Port=5432;Database=ScaleTriggerDb;User Id=YOUR-USER;Password=YOUR-PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=1000;",
    "// Sqlite": "Local file, no server needed.",
    "Sqlite": "Data Source=scaletrigger.db"
  },

  "Cache": {
    "SlidingExpirationMinutes": 5
  },

  "ForwardedHeaders": {
    "// KnownProxies": "Comma-separated IPs of reverse proxies directly in front of this app that are trusted to set X-Forwarded-For/-Proto (e.g. '127.0.0.1' for the nginx-fronted VM/scale-set deploy, where nginx is the only thing that can reach the app's loopback-only listener). Empty/unset (the default here) = no proxy trusted, Connection.RemoteIpAddress is used as-is - correct when nothing sits in front of the app (local/dev, Docker Compose exposing the container port directly). On Azure App Service, use the ASPNETCORE_FORWARDEDHEADERS_ENABLED app setting instead (see app-service.bicep) - App Service's front-end IP isn't fixed, so it can't be pinned here.",
    "KnownProxies": ""
  },

  "LoadSafety": {
    "// MaxConcurrentMemoryBytes": "Ceiling on total bytes concurrently reserved by in-flight MemoryKilobytesPerVote allocations across all requests on this instance. A burst of parallel votes stops adding new memory load once the ceiling is hit (that vote's CPU/disk/network/DB load still runs normally) instead of the sum overrunning available RAM and triggering an OOM-kill. Set below the instance's actual RAM (e.g. 5-6 GB on an 8 GB instance) to leave headroom for the OS/GC/other requests.",
    "MaxConcurrentMemoryBytes": 2147483648
  },

  "Load": {
    "// Note": "Seeds LoadConfig only the first time it's created; edit live values from the dashboard afterward. Each vote picks fresh, at random, between Min and Max (Min == Max for a fixed value).",
    "// ConfigRefresh": "Seconds between polls of LoadConfig for dashboard edits; controls how fast a change to any setting below takes effect.",
    "ConfigRefresh": { "Min": 1, "Max": 1 },
    "// LoadEnabled": "0 = disabled, 1 = enabled - master switch for per-vote load and the Vote/Payload write. While disabled, POST /api/vote/add is a fast no-op; used by the dashboard's 'Discard backlog' button.",
    "LoadEnabled": { "Min": 1, "Max": 1 },
    "// CacheEnabled": "0 = disabled, 1 = enabled - whether GET /api/vote/report is cached in memory. Unlike Cache:SlidingExpirationMinutes, this is live and shared across every node, so a scale-out node picks up the current value from the database instead of appsettings.json.",
    "CacheEnabled": { "Min": 1, "Max": 1 },
    "// CpuIterationsPerVote": "Chained SHA-512, ~0.3us/iteration on a typical core (no hardware SHA-512 acceleration) - roughly 30ms at 100,000 and 140ms at 500,000. Recalibrate for your own hardware if it differs noticeably.",
    "CpuIterationsPerVote": { "Min": 100000, "Max": 500000 },
    "MemoryKilobytesPerVote": { "Min": 0, "Max": 0 },
    "DiskWriteKilobytesPerVote": { "Min": 0, "Max": 0 },
    "NetworkLatencyMillisecondsPerVote": { "Min": 0, "Max": 0 },
    "// PayloadBytesPerVote": "0 = no Payload insert. Off by default since, unlike the others, this permanently grows the database.",
    "PayloadBytesPerVote": { "Min": 0, "Max": 0 },
    "// DbCpuIterationsPerVote": "0 = no CPU burn. Runs inside the database engine (DbCpuBurn/db_cpu_burn); per-iteration cost differs from CpuIterationsPerVote above, so recalibrate separately if enabled.",
    "DbCpuIterationsPerVote": { "Min": 0, "Max": 0 }
  },

  "NodeBenchmark": {
    "// Note": "One-off hardware benchmark from the dashboard, unrelated to per-vote Load. CPU runs continuously for CpuDurationSeconds; Memory/Disk repeat MemoryRepetitions/DiskRepetitions times; each score is the median.",
    "CpuDurationSeconds": 20,
    "MemoryBlockMegabytes": 64,
    "MemoryRepetitions": 5,
    "DiskSizeMegabytes": 20,
    "DiskRepetitions": 5
  },

  "Jwt": {
    "Key": "abcdefghijklmnopqrstuvwxyz012345",
    "Issuer": "ScaleTrigger",
    "Audience": "ScaleTrigger.Clients",
    "ExpirationMinutes": 60
  },

  "AdminUser": {
    "Username": "admin",
    "Password": "admin"
  }
}
